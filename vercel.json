{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/api-spec run codegen && pnpm --filter ai-employee run build",
  "outputDirectory": "artifacts/ai-employee/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!assets/)(?!.*\\.).+)", "destination": "/index.html" }
  ]
}
