{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/ai-employee/package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "dist/public"
      }
    }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/api/index.ts" },
    { "src": "/api/assistants", "methods": ["GET"], "dest": "/api/index.ts" },
    { "src": "/api/assistants", "methods": ["POST"], "dest": "/api/index.ts" },
    { "src": "/api/conversations", "dest": "/api/index.ts" },
    { "src": "/api/leads", "dest": "/api/index.ts" },
    { "src": "/api/appointments", "dest": "/api/index.ts" },
    { "src": "/api/subscription", "dest": "/api/index.ts" },
    { "src": "/api/knowledge", "dest": "/api/index.ts" },
    { "src": "/api/whatsapp/config", "dest": "/api/index.ts" },
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/artifacts/ai-employee/dist/public/$1" }
  ],
  "regions": ["iad1"]
}
